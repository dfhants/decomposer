+_GRAY = None                  # the page's grey levels, for what the ink mask is too coarse to show
+FAINT = 0.12                  # a faint line is this far from the paper toward the ink, at least
+
+
+def _faint_line(x_lo: int, x_hi: int, y0: float, y1: float, sp: float) -> float:
+    """Share of the gap between two staves that a faint vertical line crosses at their left end. On a small render
+    the line that opens a system is one anti-aliased pixel wide and far paler than the ink mask's threshold, so a
+    choir and its piano read as two systems. The line counts only with paper to its left: a grey patch over the
+    gap (a stamp, a watermark) is not a line."""
+    import numpy as np
+    g = _GRAY
+    H, W = g.shape
+    ya, yb = max(0, int(round(y0))), min(H, int(round(y1)))
+    if yb - ya < 2:
+        return 0.0
+    paper, ink = np.percentile(g, 50), np.percentile(g, 1)
+    pale = g[ya:yb] < paper - FAINT * max(1.0, paper - ink)
+    away = max(3, int(round(sp)))
+    best = 0.0
+    for x in range(max(away + 1, x_lo), min(W - 1, x_hi) + 1):
+        run = float(pale[:, x - 1:x + 2].any(axis=1).mean())
+        if run > best and float(pale[:, x - away - 1:x - away + 1].any(axis=1).mean()) < 0.5:
+            best = run
+    return best
+
+
